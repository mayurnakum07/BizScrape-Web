# BizScrape Web - environment template (development placeholders only)
# Copy to `.env.local` for Next.js and optionally `.env` for the Python API.
# Never commit real secrets or production credentials.

# =============================================================================
# Next.js (frontend)
# =============================================================================

# Canonical site origin for Open Graph / metadata (no trailing slash).
# Development: http://localhost:3000
# Production:   your Vercel or frontend host URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-visible Python API base URL (no trailing slash).
# Leave empty to use the local mock job provider during UI-only development.
# Development: http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# SSE reconnect budget for the browser client (optional; default 8).
NEXT_PUBLIC_SSE_MAX_RECONNECT_ATTEMPTS=8

# Server-side API base URL (Route Handlers / server components).
# Usually matches NEXT_PUBLIC_API_URL in development.
API_URL=

# =============================================================================
# Python API (backend)
# =============================================================================

# Bind address. Use 127.0.0.1 for local dev; 0.0.0.0 for containers/VPS.
HOST=127.0.0.1
PORT=8000

# Comma-separated CORS allow-list for the frontend origin(s). Never use *.
# Development: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production safety - keep false outside local debugging.
DEBUG=false
LOG_LEVEL=INFO

# Job capacity and scrape limits
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=5
MIN_API_TARGET=1
MAX_API_TARGET=500
MAX_JOB_RETRIES=3
CANCEL_TIMEOUT_SECONDS=45

# Rate limiting (per client IP, in-process)
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_CANCEL_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=65536

# SSE client reconnect hint (backend setting; frontend uses NEXT_PUBLIC_* above)
SSE_MAX_RECONNECT_ATTEMPTS=8

# On-disk job output root (use a persistent volume in production)
JOB_DATA_DIR=data/jobs

# Delete stale job directories on API startup (hours; 0 = disabled)
JOB_DATA_RETENTION_HOURS=168
