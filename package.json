{
  "name": "bizscrape-web",
  "version": "0.1.0",
  "private": true,
  "description": "BizScrape Web — Python-powered local business discovery and data enrichment tool (web interface)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:python": "python -m pytest tests/python -q",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:python"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-country-state-city": "^1.1.13",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
